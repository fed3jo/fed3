# Set to the real, public HTTPS folder containing the versioned sequence.
# NEXT_PUBLIC_FED3_FRAME_BASE_URL=
NEXT_PUBLIC_FED3_ASSET_VERSION=1.0.0

# Direct HTTPS video file URLs for the three home-page stations. Rebuild after edits.
NEXT_PUBLIC_FED3_ALTERNATIVES_VIDEO_URL=
NEXT_PUBLIC_FED3_HOME_CLOUD_VIDEO_URL=
NEXT_PUBLIC_FED3_COMMUNITIES_VIDEO_URL=

# CMS: server-only Supabase settings. Never prefix the service role with NEXT_PUBLIC.
# Leave all three empty until the schema, bucket and first manager are configured.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional fixed public origin, no trailing slash (recommended in production).
# CMS_SITE_ORIGIN=https://fed3-jo.vercel.app

# Optional: manager email used by the local backup/restore commands.
CMS_MANAGER_EMAIL=Fed3JoR@proton.me
